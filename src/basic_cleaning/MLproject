name: basic_cleaning
conda_env: conda.yml

entry_points:
  main:
    parameters:

      input_artifact:
        description: input data file name to be cleaned
        type: string

      output_artifact:
        description: cledaned data file name to be saved
        type: string

      output_type:
        description: artifact type for the cleaned data file
        type: string

      output_description:
        description: description for the cleaned data file
        type: string

      min_price:
        description: set minimum accepted price for the data cleaning
        type: float

      max_price:
        description: set maximum accepted price for the data cleaning
        type: float


    command: >-
        python run.py  --input_artifact {input_artifact}  --output_artifact {output_artifact}  --output_type {output_type}  --output_description {output_description}  --min_price {min_price}  --max_price {max_price} 
